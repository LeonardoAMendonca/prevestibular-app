# =============================================================================
#  EduSocial — Variáveis de Ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  NUNCA commite .env.local no Git.
# =============================================================================

# ── NextAuth ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=GERE_UM_SEGREDO_AQUI

# URL do seu deploy (desenvolvimento: http://localhost:3000)
NEXTAUTH_URL=https://seu-projeto.vercel.app

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Crie em: https://console.cloud.google.com → APIs & Services → Credentials
# Tipo: OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs:
#   https://seu-projeto.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET

# ── Google Apps Script ───────────────────────────────────────────────────────
# URL gerada ao publicar o GAS como Web App
# Deploy → Manage Deployments → copie a URL
GAS_API_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec
